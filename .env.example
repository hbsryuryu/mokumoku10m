# ローカル開発用の環境変数の見本です。
# このファイルを `.env` という名前でコピーし、必要な値を入れてください（`.env` は Git にコミットしません）。
#   PowerShell: Copy-Item .env.example .env
# 値を入れなくても、既定値で起動できます。

# API をブラウザから開くときのポート番号（既定: 8000）
# 静的デモ（py -m http.server 8000）と同時に動かす場合は、どちらかを別の番号にしてください。
API_PORT=8000

# データベースの接続先（ADR-0006）
# 空欄なら compose.yaml の既定値（SQLite3: sqlite:////data/app.sqlite3）を使います。
DATABASE_URL=

# --- AUTH-001 Google ログインを実装するときに使います（今は不要） ---
# Google Cloud Console で発行した値を入れます。シークレットは絶対にコミットしないでください。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
