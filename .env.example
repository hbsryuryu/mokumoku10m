# ローカル開発用の環境変数の見本です。
# このファイルを `.env` という名前でコピーし、必要な値を入れてください（`.env` は Git にコミットしません）。
#   PowerShell: Copy-Item .env.example .env
# 値を入れなくても、既定値で起動できます。

# API をブラウザから開くときのポート番号（既定: 8000）
# フロント画面も同じポートの / で配信します。
API_PORT=8000

# データベースの接続先（ADR-0006）
# 空欄なら compose.yaml の既定値（SQLite3: sqlite:////data/app.sqlite3）を使います。
DATABASE_URL=

# 実行環境。ローカル開発では local（空欄なら compose.yaml の既定値 local）。
# アプリ単体で動かしたときに未指定だと production（本番）扱いになり、開発用ログインは使えません。
APP_ENV=local

# 開発用ログイン（AUTH-002、ADR-0008）。APP_ENV=local のときだけ true にできます。
# local 以外で true にすると、安全のためアプリが起動を拒否します。
DEV_LOGIN_ENABLED=true

# ログインセッションの有効期間（時間）。空欄なら 720（30日、仮の値）
SESSION_TTL_HOURS=

# 終了処理（AUC-001）を API サーバーの中で実行する間隔（秒）。空欄なら 30。0 で止める
FINALIZER_INTERVAL_SECONDS=

# --- AUTH-001 Google ログインを実装するときに使います（今は不要） ---
# Google Cloud Console で発行した値を入れます。シークレットは絶対にコミットしないでください。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
